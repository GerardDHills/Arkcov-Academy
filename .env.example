# Arkcov Academy Environment Variables
# =====================================
# Most of these are auto-set by Vercel when you add Postgres storage.
# You only need to manually set JWT_SECRET and Stripe keys.

# ---- AUTO-SET BY VERCEL (do NOT set manually) ----
# These are injected automatically when you add Postgres in Vercel Dashboard:
# POSTGRES_URL, POSTGRES_PRISMA_URL, POSTGRES_URL_NON_POOLING,
# POSTGRES_USER, POSTGRES_HOST, POSTGRES_PASSWORD, POSTGRES_DATABASE

# ---- YOU MUST SET THESE ----

# JWT Secret — generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this

# Setup Key — used once to initialize database tables
SETUP_KEY=arkcov-init-2025

# App URL (Vercel auto-sets VERCEL_URL, but set this for Stripe redirects)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---- STRIPE (set when ready for payments) ----

# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Get this from Stripe Dashboard → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_...

# Create products in Stripe Dashboard → Products, then copy price IDs
# Member plan: $9/month
STRIPE_PRICE_MEMBER=price_...
# Family plan: $14/month
STRIPE_PRICE_FAMILY=price_...
